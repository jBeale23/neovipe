_generate_nvipe_completions() {
  local idx=$1
  shift
  local words=( "$@" )
  local current_word=${words[idx]}

  local array=(
    "--help: Show this help message and exit."
    "-h: Show this help message and exit."
    "--version: Show version information and exit."
    "-v: Show version information and exit."
    "--init: Emit a command string to initialize shell completion and exit."
    "--template: Specify template for naming temporary file buffer."
    "-t: Specify template for naming temporary file buffer."
    "--pipe-without-saving: If present, exiting \$EDITOR without saving doesn't emit an error."
    "-p: If present, exiting \$EDITOR without saving doesn't emit an error."
    "--output-file-name: If present, output temporary file name instead of contents."
    "-x: If present, output temporary file name instead of contents."
    "--delimiter: Set the delimiter emitted after filename when used in conjunction with file name output mode."
    "-d: Set the delimiter emitted after filename when used in conjunction with file name output mode."
  )
  for elem in "${array[@]}"; do
    if [[ ${elem} == "${current_word}"* ]]; then printf "%s\n" "${elem}"; fi
  done
}

_complete_nvipe_bash() {
  local IFS=$'\n'
  local raw=($(_generate_nvipe_completions "${COMP_CWORD}" "${COMP_WORDS[@]}"))
  local trimmed=()
  trimmed+=( "${raw[@]}" )

  if (( ${#raw[@]} == 1 )); then
    trimmed+=( "${raw[0]%%:*}" )
  fi

  COMPREPLY=( "${trimmed[@]}" )
}

_complete_nvipe_zsh() {
  local -a raw trimmed
  local IFS=$'\n'
  raw=($(_generate_nvipe_completions "${CURRENT}" "${words[@]}"))

  for arg in "${raw[@]}"; do trimmed+=( "${arg%%:*}" ); done
  if (( ${#raw} == 1 )); then
    trimmed+=( "${raw[1]}" )
    raw+=( "${trimmed[1]}" )
  fi

  compadd -d raw -- "${trimmed[@]}"
}

if [[ -n "${ZSH_VERSION:-}" ]]; then
  autoload -Uz compinit
  compinit
  compdef _complete_nvipe_zsh nvipe
elif [[ -n "${BASH_VERSION:-}" ]]; then
  complete -F _complete_nvipe_bash nvipe
else
  printf "Tab Completion for your shell: %s is not currently supported\nOpen an issue on NeoVipe's GitHub or submit a pull request with a patch.\n" "$SHELL" >&2
fi
